# ============================================================
# Market Prediction — 环境变量配置模板
# 复制此文件为 .env 并填入你的 API Keys
# .env 文件不会被提交到 Git
# ============================================================

# --- LLM 配置（DeepSeek） ---
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_VERIFY_SSL=true

# --- 超时配置（秒） ---
AGENT_TIMEOUT=120

# --- 日志级别 ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
